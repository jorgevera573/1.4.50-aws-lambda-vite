{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TasksTableItemsOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:336846061737:table/ms05-lambda-vite-lab-tasks"
    },
    {
      "Sid": "OwnLogStreamsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:336846061737:log-group:/aws/lambda/ms05-lambda-vite-lab-api:log-stream:*"
    }
  ]
}
