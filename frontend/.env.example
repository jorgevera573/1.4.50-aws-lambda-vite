# Copia este archivo como .env.local (excluido de Git).
#
# URL base de la API: valor del output `api_url` de Terraform, sin barra final.
#   cd terraform && terraform output -raw api_url
#
# ATENCIÓN: toda variable VITE_* se incrusta en el JavaScript público.
# Nunca pongas aquí credenciales de AWS, tokens ni otros secretos.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
